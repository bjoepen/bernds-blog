{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.framework.startCommand": "npm run dev",
  "frontMatter.content.supportedFileTypes": [
    "md",
    "mdx"
  ],
  "frontMatter.content.defaultFileType": "md",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.draftField": {
    "name": "draft",
    "type": "boolean"
  },
  "frontMatter.content.filters": [
    "contentFolders",
    "tags",
    "categories",
    "draft"
  ],
  "frontMatter.content.grouping": [
    {
      "title": "Reiseziel",
      "name": "destination"
    },
    {
      "title": "Land",
      "name": "country"
    },
    {
      "title": "Bereich",
      "name": "section"
    }
  ],
  "frontMatter.file.slugSeparator": "-",
  "frontMatter.file.preserveCasing": false,
  "frontMatter.global.timezone": "Europe/Berlin",
  "frontMatter.git.enabled": true,
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.media.publicFolder": "public/images",
  "frontMatter.media.supportedMimeTypes": [
    "image/*"
  ],
  "frontMatter.media.contentTypes": [
    {
      "name": "default",
      "fileTypes": [
        "png",
        "jpg",
        "jpeg",
        "webp",
        "avif",
        "svg"
      ],
      "fields": [
        {
          "title": "Titel",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Alternativtext",
          "name": "alt",
          "type": "string"
        },
        {
          "title": "Bildunterschrift",
          "name": "caption",
          "type": "string"
        }
      ]
    }
  ],
  "frontMatter.content.pageFolders": [
    {
      "title": "Reisen",
      "path": "[[workspace]]/src/content/reisen",
      "contentTypes": [
        "reisebericht"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Reisetage",
      "path": "[[workspace]]/src/content/reisetage",
      "contentTypes": [
        "reisetag",
        "seetag",
        "reisetag-mobile"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Häfen",
      "path": "[[workspace]]/src/content/haefen",
      "contentTypes": [
        "hafen"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Schiffe",
      "path": "[[workspace]]/src/content/schiffe",
      "contentTypes": [
        "schiff"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Orte",
      "path": "[[workspace]]/src/content/orte",
      "contentTypes": [
        "ort"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Fotospots",
      "path": "[[workspace]]/src/content/fotospots",
      "contentTypes": [
        "fotospot"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Ausrüstung",
      "path": "[[workspace]]/src/content/ausruestung",
      "contentTypes": [
        "ausruestung"
      ],
      "excludePaths": [
        "_*.*"
      ]
    },
    {
      "title": "Artikel",
      "path": "[[workspace]]/src/content/artikel",
      "contentTypes": [
        "artikel"
      ],
      "excludePaths": [
        "_*.*"
      ]
    }
  ],
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "routeStop",
      "labelField": "name",
      "fields": [
        {
          "title": "Nummer",
          "name": "number",
          "type": "number",
          "required": true,
          "numberOptions": {
            "min": 1,
            "step": 1
          }
        },
        {
          "title": "Ort / Hafen",
          "name": "name",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Datum",
          "name": "date",
          "type": "string",
          "single": true,
          "description": "Beispiel: 11. Oktober 2025"
        },
        {
          "title": "Breitengrad",
          "name": "latitude",
          "type": "number",
          "required": true,
          "numberOptions": {
            "isDecimal": true,
            "step": 0.0001
          }
        },
        {
          "title": "Längengrad",
          "name": "longitude",
          "type": "number",
          "required": true,
          "numberOptions": {
            "isDecimal": true,
            "step": 0.0001
          }
        },
        {
          "title": "Am Ende zum Start zurückkehren",
          "name": "returnAtEnd",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "id": "galleryImage",
      "labelField": "caption",
      "fields": [
        {
          "title": "Bild",
          "name": "src",
          "type": "image",
          "required": true
        },
        {
          "title": "Alternativtext",
          "name": "alt",
          "type": "string",
          "required": true,
          "description": "Sachliche Bildbeschreibung für Barrierefreiheit und SEO."
        },
        {
          "title": "Bildunterschrift",
          "name": "caption",
          "type": "string"
        },
        {
          "title": "Breite in Pixel",
          "name": "width",
          "type": "number",
          "numberOptions": {
            "min": 1,
            "step": 1
          }
        },
        {
          "title": "Höhe in Pixel",
          "name": "height",
          "type": "number",
          "numberOptions": {
            "min": 1,
            "step": 1
          }
        }
      ]
    },
    {
      "id": "placeSpot",
      "labelField": "name",
      "fields": [
        {
          "title": "Name",
          "name": "name",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Breitengrad",
          "name": "latitude",
          "type": "number",
          "required": true,
          "numberOptions": {
            "isDecimal": true,
            "step": 0.0001
          }
        },
        {
          "title": "Längengrad",
          "name": "longitude",
          "type": "number",
          "required": true,
          "numberOptions": {
            "isDecimal": true,
            "step": 0.0001
          }
        },
        {
          "title": "Hinweis",
          "name": "note",
          "type": "string"
        },
        {
          "title": "Objektiv / Brennweite",
          "name": "lens",
          "type": "string",
          "single": true
        },
        {
          "title": "Beste Tageszeit",
          "name": "bestTime",
          "type": "string",
          "single": true
        }
      ]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "reisetag",
      "pageBundle": false,
      "fileType": "md",
      "clearEmpty": true,
      "template": "[[workspace]]/.frontmatter/templates/reisetag.mdx",
      "previewPath": "'reisetage/' + $fileName",
      "fields": [
        {
          "title": "Inhaltstyp",
          "name": "type",
          "type": "string",
          "hidden": true,
          "required": true
        },
        {
          "title": "Titel",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Kurzbeschreibung",
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "title": "Veröffentlichungsdatum",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true,
          "required": true
        },
        {
          "title": "Entwurf",
          "name": "draft",
          "type": "draft",
          "default": true
        },
        {
          "type": "heading",
          "title": "Reisetag"
        },
        {
          "title": "Art des Tages",
          "name": "dayType",
          "type": "choice",
          "choices": [
            "anreise",
            "landgang",
            "seetag",
            "ausschiffung"
          ],
          "default": "landgang"
        },
        {
          "title": "Untertitel",
          "name": "subtitle",
          "type": "string"
        },
        {
          "title": "Reisedatum",
          "name": "travelDate",
          "type": "datetime"
        },
        {
          "title": "Zugehörige Reise",
          "name": "trip",
          "type": "string",
          "required": true
        },
        {
          "title": "Tag",
          "name": "day",
          "type": "number",
          "required": true,
          "numberOptions": {
            "min": 1,
            "step": 1
          }
        },
        {
          "title": "Ort",
          "name": "location",
          "type": "string",
          "required": true
        },
        {
          "title": "Land",
          "name": "country",
          "type": "string"
        },
        {
          "title": "Ankunft",
          "name": "arrival",
          "type": "string"
        },
        {
          "title": "Abfahrt",
          "name": "departure",
          "type": "string"
        },
        {
          "title": "Aktivität",
          "name": "activity",
          "type": "string"
        },
        {
          "title": "Tenderhafen",
          "name": "tender",
          "type": "boolean",
          "default": false
        },
        {
          "title": "Verknüpfter Hafenbeitrag",
          "name": "portSlug",
          "type": "string"
        },
        {
          "title": "Wetter",
          "name": "weather",
          "type": "string"
        },
        {
          "title": "Temperatur",
          "name": "temperature",
          "type": "string"
        },
        {
          "title": "Fotografische Bewertung",
          "name": "photoRating",
          "type": "number",
          "numberOptions": {
            "min": 1,
            "max": 5,
            "step": 1
          }
        },
        {
          "title": "Moment des Tages",
          "name": "momentOfDay",
          "type": "string"
        },
        {
          "title": "Die kleine Erinnerung",
          "name": "smallMemory",
          "type": "string"
        },
        {
          "type": "heading",
          "title": "Bilder und SEO"
        },
        {
          "title": "Hero-Bild",
          "name": "heroImage",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "Alternativtext Hero",
          "name": "heroAlt",
          "type": "string"
        },
        {
          "title": "Bildunterschrift Hero",
          "name": "heroCaption",
          "type": "string"
        },
        {
          "title": "Galerie-Titel",
          "name": "galleryTitle",
          "type": "string"
        },
        {
          "title": "Galeriebilder",
          "name": "gallery",
          "type": "block",
          "fieldGroup": [
            "galleryImage"
          ]
        },
        {
          "title": "Kategorien",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Schlagwörter",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "SEO-Titel",
          "name": "seoTitle",
          "type": "string"
        },
        {
          "title": "SEO-Beschreibung",
          "name": "seoDescription",
          "type": "string"
        },
        {
          "title": "Canonical URL",
          "name": "canonical",
          "type": "string"
        },
        {
          "title": "OpenGraph-Bild",
          "name": "ogImage",
          "type": "image"
        }
      ]
    },
