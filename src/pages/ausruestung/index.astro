---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('ausruestung', ({data}) => import.meta.env.DEV || !data.draft))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Ausrüstung" description="Kameras, Objektive und Zubehör aus der Reisepraxis.">
  <header class="page-header"><div class="container"><div class="eyebrow">Aus der Praxis</div><h1>Ausrüstung</h1><p class="lead">Kameras, Objektive und Zubehör – bewertet nach dem Einsatz unterwegs.</p></div></header>
  <section class="section"><div class="container"><div class="grid">
    {entries.length ? entries.map((entry) => <ContentCard href={`/ausruestung/${entry.id}/`} eyebrow={entry.data.equipmentType} title={entry.data.title} description={entry.data.description} tags={entry.data.tags} />) : <div class="notice">Ausrüstungsartikel werden später aus den konkreten Reiseerfahrungen ergänzt.</div>}
  </div></div></section>
</BaseLayout>
