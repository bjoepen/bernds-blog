---
import './NorthStarNavigation.css';
import northStarUrl from './north-star.svg?url';

interface Props {
  label?: string;
  revealAt?: number;
}

const {
  label = 'Zum Seitenanfang',
  revealAt = 0.4
} = Astro.props;

const safeRevealAt = Math.min(1, Math.max(0, revealAt));
---

<button
  class="north-star-navigation"
  type="button"
  aria-label={label}
  data-north-star-navigation
  data-reveal-at={safeRevealAt}
>
  <svg
    class="north-star-navigation__progress"
    viewBox="0 0 52 52"
    aria-hidden="true"
  >
    <circle class="north-star-navigation__track" cx="26" cy="26" r="23" pathLength="100" />
    <circle class="north-star-navigation__value" cx="26" cy="26" r="23" pathLength="100" />
  </svg>
  <span
    class="north-star-navigation__star"
    style={`--north-star-url: url("${northStarUrl}")`}
    aria-hidden="true"
  ></span>
  <svg class="north-star-navigation__arrow" viewBox="0 0 24 24" aria-hidden="true">
    <path d="m6.5 13 5.5-5.5 5.5 5.5M12 7.5v9" />
  </svg>
</button>

<script src="./NorthStarNavigation.ts"></script>
